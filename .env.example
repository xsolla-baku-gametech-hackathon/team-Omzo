# Copy to .env and fill in. .env is never committed.

# Postgres from docker-compose.yml — note host port 5434, not 5432.
DATABASE_URL="postgresql://repro:repro@localhost:5434/repro?schema=public"

# REQUIRED outside development. All three secrets below are validated at use:
# blank, whitespace, or under 32 characters is refused rather than substituted,
# so a deploy that forgets one fails to start instead of signing with a key
# that is public in this repository. Leave them blank locally and the dev
# server falls back to a clearly-marked development key, with a warning.

# Session JWT signing key (jose, HS256). Generate: openssl rand -base64 32
SESSION_SECRET=""

# HMAC key for per-tester build access tokens, and the credential POST
# /api/ingest authenticates reports against. Anyone holding this can mint a
# grant for any campaign and file reports as any tester.
# Generate: openssl rand -base64 32
ACCESS_SECRET=""

# Salt for hashing IPs before storage. We never store a raw IP -- but that
# only holds while this is secret: IPv4 is about four billion values, so a
# published salt makes every stored hash reversible by brute force.
# Generate: openssl rand -base64 32
APP_SALT=""

# OPTIONAL. Enrichment only — rewrites issue titles and may refine category.
# Leave empty and the app runs identically with deterministic fallback titles.
# It is never on the critical path and never required for the demo.
ANTHROPIC_API_KEY=""

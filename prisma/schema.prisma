// The whole data model, in one migration (SPEC.md §4, §0.5).
//
// Three fields exist here that §4 does not list, each required by another
// section rather than invented:
//   Report.clientReportId    — §7 has the overlay retry with backoff, so
//                              ingest must be idempotent or a retry
//                              double-counts an occurrence.
//   Report.isPossibleDuplicate — §5.3 holds borderline reports for one-click
//                              confirm/split; they are attached to an issue
//                              without counting towards it.
//   Report.normalisedBody    — cached alongside tokens for the same reason
//                              tokens are cached: severity re-reads it on
//                              every attach.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(TESTER)
  signalScore  Int       @default(100) // 0–200, starts neutral
  birthDate    DateTime? // age is computed server-side at NDA signing
  createdAt    DateTime  @default(now())

  studio                 Studio?
  ndaSignatures          NdaSignature[]
  reports                Report[]
  ledgerEntries          LedgerEntry[]
  accessGrants           AccessGrant[]
  rewardClaims           RewardClaim[]
  campaignApplications   CampaignApplication[] @relation("Applicant")
  resolvedApplications   CampaignApplication[] @relation("ApplicationResolver")
}

enum Role {
  TESTER
  STUDIO
}

model Studio {
  id        String     @id @default(cuid())
  name      String
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id])
  campaigns Campaign[]

  subscription       Subscription?
  subscriptionEvents SubscriptionEvent[]
}

/// The plan a studio is on. One row per studio; absence means the free tier,
/// so a studio that never touched billing needs no row at all.
model Subscription {
  id        String   @id @default(cuid())
  studioId  String   @unique
  studio    Studio   @relation(fields: [studioId], references: [id])
  /// Matches PlanId in src/domain/billing/plans.ts. Deliberately a string
  /// rather than an enum: the catalogue is domain logic that changes with
  /// pricing, and a migration per price experiment is the wrong coupling.
  planId    String
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Every plan change, kept for as long as the studio exists.
///
/// Usage accrues over a period but a plan can change inside one, so an
/// invoice cannot be reconstructed from the current plan alone. This is the
/// record that answers "what were they on when this usage accrued", and it
/// is append-only for the same reason a ledger is.
model SubscriptionEvent {
  id         String   @id @default(cuid())
  studioId   String
  studio     Studio   @relation(fields: [studioId], references: [id])
  /// null on the first move off the implicit free tier.
  fromPlanId String?
  toPlanId   String
  /// The user who made the change, not the studio, so it is attributable.
  actorId    String
  createdAt  DateTime @default(now())

  @@index([studioId, createdAt])
}

model Campaign {
  id              String         @id @default(cuid())
  studioId        String
  studio          Studio         @relation(fields: [studioId], references: [id])
  title           String
  pitch           String // one paragraph shown to testers
  testFocus       String // "what we need you to break"
  buildKind       BuildKind
  buildUrl        String // internal path or external link
  status          CampaignStatus @default(OPEN)
  maxTesters      Int            @default(200)
  ndaBodyMd       String
  rewardPoolTotal Int            @default(0) // in coins
  rewardPerIssue  Int            @default(50)
  revokedAt       DateTime? // set → every live grant is invalid at once
  /// When testers may submit a DOWNLOAD application.
  applicationOpensAt  DateTime
  applicationClosesAt DateTime
  /// When approved testers may play and file reports.
  testingStartsAt     DateTime
  testingEndsAt       DateTime
  createdAt       DateTime       @default(now())

  reports       Report[]
  issues        Issue[]
  ndaSignatures NdaSignature[]
  accessGrants  AccessGrant[]
  rewardItems   RewardItem[]
  applications  CampaignApplication[]
}

/**
 * A tester asking for DOWNLOAD access. Link/web campaigns skip this —
 * only binary delivery requires studio approval before NDA + grant.
 */
model CampaignApplication {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  testerId     String
  tester       User              @relation("Applicant", fields: [testerId], references: [id])
  status       ApplicationStatus @default(PENDING)
  message      String?
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?             @relation("ApplicationResolver", fields: [resolvedById], references: [id])

  @@unique([campaignId, testerId])
  @@index([campaignId, status])
  @@index([testerId, createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

enum BuildKind {
  WEB_EMBED
  DOWNLOAD
  EXTERNAL_LINK
}

/**
 * Every attempt to reach a build, granted or refused.
 * AccessGrant is one row per tester per campaign for life, rewritten in place
 * on re-issuance, so it can only ever answer "when did they last ask". The
 * question a studio has after a leak is "who opened this, and when" — which
 * needs a row per attempt, never updated.
 * Deliberately holds no foreign keys. An audit record that cascades away with
 * the campaign it audits is not an audit record, and a denied attempt may
 * name a user or campaign that does not resolve at all.
 */
model AccessEvent {
  id         String        @id @default(cuid())
  campaignId String
  userId     String? // absent when the token did not parse
  grantId    String?
  outcome    AccessOutcome
  buildKind  BuildKind // what delivery mode was in force at the time
  uaHash     String
  ipHash     String // sha256(ip + APP_SALT) — never the raw address
  createdAt  DateTime      @default(now())

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
}

enum AccessOutcome {
  GRANTED
  DENIED_INVALID_TOKEN
  DENIED_UA_MISMATCH
  DENIED_EXPIRED
  DENIED_REVOKED
  DENIED_CONSUMED
  DENIED_OUTSIDE_WINDOW
  DENIED_NOT_APPROVED
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

model NdaSignature {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String
  typedName   String
  ndaBodyHash String // sha256 of the exact text signed
  ipHash      String // sha256(ip + APP_SALT) — never the raw address
  userAgent   String
  signedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([userId, campaignId])
}

model AccessGrant {
  id              String    @id @default(cuid())
  userId          String
  campaignId      String
  nonce           String    @unique // single use, rewritten on re-issuance
  watermarkId     Int       @unique // globally unique, 16-bit, from a sequence
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  uaHash          String
  issuanceCount   Int       @default(1) // re-issuances in the current window
  windowStartedAt DateTime  @default(now()) // rolling 1h rate-limit window

  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  // One row per tester per campaign, for life. Re-issuance updates it in
  // place and keeps watermarkId, which is what lets a decoded frame name a
  // person rather than a session.
  @@unique([userId, campaignId])
}

model Report {
  id             String   @id @default(cuid())
  campaignId     String
  reporterId     String
  body           String
  screenshotData String?  @db.Text // data URL: ≤1280px wide, JPEG q0.8, ≤2 MB
  gameState      Json // scene, coords, playtimeSec
  systemInfo     Json // os, browser, gpuRenderer, screen, memory
  consoleTail    String[] // last 50 lines

  // Cached deterministic derivations. Recomputing these on every ingest for
  // every report in the campaign is the one thing that would not scale.
  signature      String
  tokens         String[]
  normalisedBody String

  issueId             String?
  isNoise             Boolean @default(false)
  isPossibleDuplicate Boolean @default(false)

  // Supplied by the client so a retried submission is recognised rather than
  // counted twice. Unique per campaign, not globally.
  clientReportId String?

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  reporter User     @relation(fields: [reporterId], references: [id])
  issue    Issue?   @relation(fields: [issueId], references: [id])

  @@unique([campaignId, clientReportId])
  @@index([campaignId, createdAt])
  @@index([issueId])
}

model Issue {
  id              String        @id @default(cuid())
  campaignId      String
  title           String
  category        IssueCategory
  severity        Severity
  status          IssueStatus   @default(OPEN)
  firstReporterId String
  occurrenceCount Int           @default(1)
  signature       String
  sharedTraits    Json // {"gpu":{"AMD":16,"NVIDIA":2}, ...}
  createdAt       DateTime      @default(now())
  verifiedAt      DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  reports  Report[]

  @@index([campaignId, severity])
}

enum IssueCategory {
  CRASH
  VISUAL
  GAMEPLAY
  PERFORMANCE
  AUDIO
  UX
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  VERIFIED
  REJECTED
  FIXED
}

model LedgerEntry {
  id             String       @id @default(cuid())
  userId         String
  campaignId     String
  issueId        String?
  amount         Int
  reason         LedgerReason
  // The idempotency mechanism itself: insert, catch the unique violation,
  // return the existing row. Never SELECT-then-INSERT, which races.
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([campaignId])
}

enum LedgerReason {
  ISSUE_VERIFIED
  FIRST_REPORTER_BONUS
  MANUAL_ADJUSTMENT
  // Spending, not earning: a claim is a negative entry in the same ledger.
  // Deliberately outside the set of reasons that draw down a campaign's pool
  // — counting it there would let a tester spending coins refund the studio's
  // pool and let the campaign pay out more than it promised.
  REWARD_CLAIMED
  CLAIM_REFUNDED
}

/**
 * Something a studio will hand over for coins.
 * Repro never buys or holds these. The studio funds its own shelf out of
 * inventory that costs it almost nothing — a credits line, a spare key — and
 * is worth real money to a tester. That asymmetry is the only reason the
 * economy works without us funding anything.
 */
model RewardItem {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind         RewardKind
  label        String // "Steam key — Deepfall"
  costCoins    Int
  totalStock   Int
  // Denormalised on purpose: it is the column the stock check locks. Counting
  // claims instead would mean locking every claim row to serialise the last
  // key in the box.
  claimedCount Int        @default(0)
  createdAt    DateTime   @default(now())

  claims RewardClaim[]

  @@index([campaignId])
}

enum RewardKind {
  CREDITS_MENTION
  EARLY_ACCESS
  ITEM_CODE
  STEAM_KEY
}

/**
 * A tester spending coins on one of those.
 * idempotencyKey is "claim:<userId>:<rewardItemId>", so the unique constraint
 * does two jobs: a double-clicked button debits once, and a tester gets one of
 * each item rather than emptying the shelf. Fulfilment is manual — the studio
 * pastes a code — because that is what an early product honestly does.
 */
model RewardClaim {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  rewardItemId   String
  rewardItem     RewardItem  @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
  status         ClaimStatus @default(REQUESTED)
  fulfilledCode  String? // pasted by the studio, never generated by us
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  resolvedAt     DateTime?

  @@index([rewardItemId, createdAt])
  @@index([userId, createdAt])
}

enum ClaimStatus {
  REQUESTED
  FULFILLED
  CANCELLED
}
